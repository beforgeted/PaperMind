# ============================================
# PaperMind backend configuration (example)
# Copy to `.env` and adjust values for local run.
# ============================================

# ---- App ----
APP_NAME=PaperMind
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=log
LOG_RETENTION_DAYS=30
LOG_TO_STDOUT=true
LOG_JSON_TO_FILE=true
LOG_LLM_PAYLOADS=false
LOG_DATE_SUBDIRS=true
LOG_AGENT_BUSINESS_FILE=true

# ---- MinIO ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=papermind
MINIO_SECRET_KEY=papermind123
MINIO_BUCKET=papers
MINIO_SECURE=false

# ---- Redis ----
REDIS_URL=redis://localhost:6380/2
UPLOAD_STATE_TTL_SECONDS=86400

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PARSE=papermind.parse
KAFKA_GROUP_ID=papermind-worker
KAFKA_CLIENT_ID=papermind-api

# ---- Elasticsearch ----
ES_HOSTS=http://localhost:9201
ES_USERNAME=
ES_PASSWORD=
ES_INDEX_PARENT=papermind_parents
ES_INDEX_CHILD=papermind_children
ES_VECTOR_DIMS=1024

# ---- Embedding (Qwen) ----
# Choose backend: "dashscope" (cloud API) or "local" (HF model)
EMBEDDING_BACKEND=dashscope
EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_API_KEY=your-dashscope-api-key
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# ---- LLM (DashScope / 通义，与上方 DASHSCOPE_API_KEY 共用) ----
LLM_MODEL=qwen3-max

# ---- Chunking ----
PARENT_CHUNK_SIZE=1024
PARENT_CHUNK_OVERLAP=150
CHILD_CHUNK_SIZE=256
CHILD_CHUNK_OVERLAP=32
RETRIEVE_INCLUDE_NEXT_PARENT=true

# ---- Retrieval ----
RETRIEVE_TOP_K_KNN=20
RETRIEVE_TOP_K_BM25=20
RRF_K=60
FINAL_TOP_K=5
